# Local Orin runtime. The launcher supplies the absolute SQLite database URL
# under the user data directory; do not point this at Docker/PostgreSQL.
DATABASE_URL=
AGENTOS_ENV=local
LOCALHOST_TRUST_ENABLED=true
WEB_DIST_DIR=frontend/dist

# Providers are deny-by-default. Configure keys in Settings -> Providers; they
# are encrypted in the local database and never need to be in this file.
OPENROUTER_ENABLED=false
OPENROUTER_API_KEY=
AGENTOS_PROVIDER_ENCRYPTION_KEY=
ANTHROPIC_ENABLED=false
ANTHROPIC_API_KEY=
OPENAI_ENABLED=false
OPENAI_API_KEY=
