# Required production infrastructure. Values come from the deployment secret
# manager; do not commit real credentials. For this repository's Docker Compose
# ports use localhost:5433 and localhost:6380 when those ports are available.
DATABASE_URL=
REDIS_URL=redis://localhost:6379/0
AGENTOS_ENV=development
# Keep disabled for shared environments and future VPS deployments. The local
# personal profile lives in .env.local.example and is deliberately loopback-only.
LOCALHOST_TRUST_ENABLED=false
WEB_DIST_DIR=

# Providers are deny-by-default. Every enabled provider needs a key. Model
# selections come from the server-managed catalog and are stored per user; a
# model is not part of the provider credential.
OPENROUTER_ENABLED=false
OPENROUTER_API_KEY=
AGENTOS_PROVIDER_ENCRYPTION_KEY=
ANTHROPIC_ENABLED=false
ANTHROPIC_API_KEY=
OPENAI_ENABLED=false
OPENAI_API_KEY=
