    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "react-router-dom": "7.18.2",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^3.4.17",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.3",
    "@types/node": "26.2.0",
