{
  "name": "orin-desktop",
  "private": true,
  "version": "0.1.14",
  "author": "Carlos Eduardo",
  "description": "Electron host for the Orin local application",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --devtools",
    "build": "electron-builder --win",
    "build:dir": "electron-builder --win --dir"
  },
  "devDependencies": {
    "electron": "^37.2.6",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "dev.orin.desktop",
    "productName": "Orin Desktop",
    "asar": true,
    "icon": "electron/assets/orin-logo.ico",
    "files": [
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../dist/runtime",
        "to": "runtime",
        "filter": ["**/*"]
      },
      {
        "from": "../LICENSE",
        "to": "LICENSE"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "executableName": "Orin Desktop"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
