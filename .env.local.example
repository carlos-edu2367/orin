# Local personal-installation profile. This file deliberately enables no
# provider; add keys through the local UI, not here.
DATABASE_URL=postgresql+psycopg://agentos@127.0.0.1:5433/agentos
REDIS_URL=redis://127.0.0.1:6380/0
AGENTOS_ENV=local
LOCALHOST_TRUST_ENABLED=true
WEB_DIST_DIR=frontend/dist
AGENTOS_PROVIDER_ENCRYPTION_KEY=

# Optional F harness gate; leave unset to skip the real PostgreSQL/Redis smoke.
# AGENTOS_TEST_POSTGRES_DSN=postgresql+psycopg://agentos@127.0.0.1:5433/agentos
# AGENTOS_REDIS_URL=redis://127.0.0.1:6380/0
# The deterministic provider fixture needs no key and is started by pytest.
